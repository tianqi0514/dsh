{
  "name": "workdsh-plugin-chuanshen",
  "version": "0.1.0-alpha.3",
  "private": false,
  "type": "module",
  "description": "NexusOne tools for Chuanshen knowledge ingestion, reasoning, calculation and writing",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client-entry.d.ts",
      "default": "./dist/client.browser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../../scripts/build-chuanshen.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "corepack pnpm --filter workdsh-plugin-chuanshen build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.6-alpha.2",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.6-alpha.2",
    "@types/react": "19.2.14",
    "react": "19.2.4",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
